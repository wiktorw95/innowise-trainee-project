{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "allowJs": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "rootDir": "../../",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      /* Point these to the .ts files, not .js */
      "@innogram/shared": ["../../packages/shared/src/index.ts"],
      "@innogram/types": ["../../packages/types/src/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "strictPropertyInitialization": true
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/types/src/**/*",
    "../../packages/shared/generated/prisma/client.ts"
  ],
  "exclude": ["node_modules", "dist", "test"]
}
