generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "main", "notification"]
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  @@schema("auth")
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  @@schema("main")
}

model Notification {
  id      Int     @id @default(autoincrement())
  message String
  isRead  Boolean @default(false)

  @@schema("notification")
}
